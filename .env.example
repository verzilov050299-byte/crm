# Скопируйте в файл .env и подставьте свои значения.
# Файл .env в git не коммитьте.

SECRET_KEY=замените-на-длинную-случайную-строку
SITE_URL=https://ваш-сайт.onrender.com
SITE_NAME=BizCRM Автосервис

# Локально можно не трогать — будет SQLite.
# На Render/Railway вставьте URL базы PostgreSQL:
# DATABASE_URL=postgresql://user:pass@host/dbname

# Почта (пример для Yandex / Mail.ru / корпоративного SMTP)
MAIL_SERVER=smtp.yandex.ru
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USERNAME=ваш@yandex.ru
MAIL_PASSWORD=пароль-приложения
MAIL_FROM=ваш@yandex.ru

# 1 — любой может зарегистрироваться с сайта
# 0 — только приглашения администратора
ALLOW_PUBLIC_REGISTER=1
